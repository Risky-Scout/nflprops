# Template for /home/wizard-deploy/nflprops/nflprops-runtime.env on the
# Wizard host (mode 600, owned by wizard-deploy). On first install ONLY,
# deploy-wizard.yml renders this template with the BDL_API_KEY secret of
# the wizardofodds.com GitHub environment and installs it; it NEVER
# overwrites an existing file and never prints the secret. To edit an
# existing file, change it on the host as wizard-deploy.
#
# NEVER commit a filled-in copy (deploy/systemd/*.env is gitignored; only
# this *.env.example template is tracked).

# The locked zero-cost architecture: DuckDB/Parquet + versioned immutable
# snapshots is production truth, no database server. NFLPROPS_DATA_ROOT is
# the collector's `run.data_root`: warehouse tables live in
# <data_root>/canonical, the DuckDB query layer at <data_root>/nflprops.duckdb,
# immutable raw provider payloads under <data_root>/raw. It MUST be absolute
# in production (StorageSettings enforces this).
NFLPROPS_ENV=production
NFLPROPS_STORAGE_BACKEND=duckdb
NFLPROPS_DATA_ROOT=/home/wizard-deploy/nflprops/state

# The probe-approved isolated runtime root: snapshots/, publications/,
# backups/, logs/, locks/ live directly under it
# (nflprops.platform.runtime_layout).
NFLPROPS_RUNTIME_ROOT=/home/wizard-deploy/nflprops

# Bounded snapshot retention (~11 GB free at probe time) -- never unlimited.
# Snapshots referenced by checkpoints still pending GitHub execution are
# protected in addition to this count.
NFLPROPS_SNAPSHOT_RETENTION=7

# The running release's git SHA is read from <release>/RELEASE_SHA (written
# by deploy/wizard/prepare_release.sh). Do NOT set
# NFLPROPS_RUNTIME_VERSION_SHA here: it would override that marker for
# every release and make the deploy gate's --expect-version check fail.

# Optional: logging level (the runtime logs one JSON object per line).
NFLPROPS_LOG_LEVEL=INFO

# Live provider credential (ball-don't-lie). REQUIRED: the collector and
# the deploy gate's provider_config check fail closed without it.
BDL_API_KEY=
