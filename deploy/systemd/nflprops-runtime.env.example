# BLOCK 2B: template for /etc/nflprops/nflprops-runtime.env on the Wizard
# host. Copy this file there, fill in real values, and set strict
# permissions:
#
#   sudo install -d -m 750 -o wizard-deploy -g wizard-deploy /etc/nflprops
#   sudo cp deploy/systemd/nflprops-runtime.env.example /etc/nflprops/nflprops-runtime.env
#   sudo chown wizard-deploy:wizard-deploy /etc/nflprops/nflprops-runtime.env
#   sudo chmod 640 /etc/nflprops/nflprops-runtime.env
#
# NEVER commit the filled-in file -- it is deliberately outside git
# (deploy/systemd/*.env is gitignored; only this *.env.example template is
# tracked). Referenced by deploy/systemd/nflprops-runtime.service via
# EnvironmentFile=.

# The locked zero-cost architecture (docs/PLATFORM_AUTOMATION.md, BLOCK 2B):
# DuckDB + versioned immutable snapshots is production truth here, no
# PostgreSQL required. NFLPROPS_DATA_ROOT MUST be an explicit absolute path
# in production (nflprops.data.storage.settings.StorageSettings enforces
# this) -- its PARENT directory is the runtime state root that also holds
# snapshots/ and locks/ (nflprops.platform.warehouse_snapshot / writer_lock).
NFLPROPS_ENV=production
NFLPROPS_STORAGE_BACKEND=duckdb
NFLPROPS_DATA_ROOT=/var/lib/nflprops/warehouse

# Baked in by the deploy workflow at release time (the exact git SHA of the
# release being run) -- reported by `nflprops platform health`.
NFLPROPS_RUNTIME_VERSION_SHA=

# Optional: logging level.
NFLPROPS_LOG_LEVEL=INFO

# Provider API key(s), only if/when continuous collection is activated
# (Block 3) -- never populated by BLOCK 2B itself.
BDL_API_KEY=
