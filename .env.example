# Copy to .env and fill in. .env is gitignored and MUST stay that way.
# The key is read from the environment only — it never enters git, run manifests,
# logs, raw response metadata, or model artifacts. SPEC §10.

BDL_API_KEY=

# Optional: where the warehouse lives. Defaults to ./data
NFLPROPS_DATA_ROOT=./data

# Optional: logging level
NFLPROPS_LOG_LEVEL=INFO

# --- Production storage (PHASE 1 / BLOCK 2B) --------------------------------
# See src/nflprops/data/storage/settings.py for validation rules. Everything
# below is optional for local development. NFLPROPS_ENV=production accepts
# EITHER NFLPROPS_STORAGE_BACKEND=postgres (with DATABASE_URL) OR the locked
# zero-cost architecture, NFLPROPS_STORAGE_BACKEND=duckdb with NFLPROPS_DATA_ROOT
# set to an explicit ABSOLUTE path (never the relative default above) -- see
# docs/PLATFORM_AUTOMATION.md and deploy/systemd/nflprops-runtime.env.example.

# development|production. Defaults to development.
NFLPROPS_ENV=development

# duckdb|postgres. Defaults to duckdb (the local Parquet warehouse above).
NFLPROPS_STORAGE_BACKEND=duckdb

# Required when NFLPROPS_STORAGE_BACKEND=postgres.
# postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=

# S3-compatible object storage for large simulation artifacts (joint draw
# matrices, projections, market boards). Not AWS-specific — works against
# AWS S3, MinIO, or any other S3-compatible endpoint.
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=
OBJECT_STORE_BUCKET=
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=

# Orchestration (documented now, not yet consumed — Prefect phase).
PREFECT_API_URL=
PREFECT_API_KEY=
